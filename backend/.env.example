# ── Admin key — REQUIRED for any real/multi-client deployment ──
# Master key for account management only (POST/GET/DELETE /api/admin/*).
# Clients never see or use this — they log in with their own username/
# password, created by you via this key. Unset + zero client accounts
# created = fully open, no-login dev mode (fine for local dev only).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ADMIN_KEY=choose_a_long_random_key

# ── LLM providers — at least one needed for AI features ──
# Without these, upload/clean/EDA/BI/ML/charts/exports all still work —
# only Chat, RAG, image/video-to-dataset extraction, and AI PDF
# narratives are disabled (with a clear message, not a crash).
GROQ_API_KEY=gsk_your_key_here          # console.groq.com (free) — Chat copilot
GEMINI_API_KEY=your_gemini_key_here     # aistudio.google.com (free) — image/video/RAG

# ── Storage ──
# DATA_DIR=./data
# Days before an idle dataset/RAG knowledge base is auto-deleted. 0 disables.
# DATA_TTL_DAYS=30
# How often the expiry sweep runs in the background (hours).
# CLEANUP_INTERVAL_HOURS=6

# ── Auth internals (optional) ──
# Signs client login tokens. Auto-generated + persisted if you leave this
# unset — only set it explicitly if you run multiple backend instances
# behind a load balancer, so they all accept each other's tokens.
# APP_SECRET=
# How many days a client stays logged in before signing in again.
# TOKEN_TTL_DAYS=30

# ── CORS ──
# CORS_ORIGINS=https://yourdomain.com
