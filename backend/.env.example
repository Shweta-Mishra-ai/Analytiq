# Workspace password — REQUIRED for any public deployment.
# Every visitor must enter this before seeing any data.
APP_PASSWORD=choose_a_strong_password

# LLM providers — at least one is needed for AI features
GROQ_API_KEY=gsk_your_key_here          # console.groq.com (free)
GEMINI_API_KEY=your_gemini_key_here     # aistudio.google.com (free) — required for image/video RAG

# Storage (defaults to ./data)
# DATA_DIR=./data

# CORS (defaults to *)
# CORS_ORIGINS=https://yourdomain.com
