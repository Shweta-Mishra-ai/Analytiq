# ── Admin key — REQUIRED for any real/multi-client deployment ──
# Master key for account management only (POST/GET/DELETE /api/admin/*).
# Clients never see or use this — they log in with their own username/
# password, created by you via this key. Unset + zero client accounts
# created = fully open, no-login dev mode (fine for local dev only).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ADMIN_KEY=choose_a_long_random_key

# ── LLM providers — at least one needed for AI features ──
# Without these, upload/clean/EDA/BI/ML/charts/exports all still work —
# only Chat, RAG, image/video-to-dataset extraction, and AI PDF
# narratives are disabled (with a clear message, not a crash).
# Claude (Anthropic): tried first for chat, narratives and knowledge-base answers.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

GROQ_API_KEY=gsk_your_key_here          # console.groq.com (free) — Chat copilot
GEMINI_API_KEY=your_gemini_key_here     # aistudio.google.com (free) — image/video/RAG

# ── Storage ──
# DATA_DIR=./data
# Days before an idle dataset/RAG knowledge base is auto-deleted. 0 disables.
# DATA_TTL_DAYS=30
# How often the expiry sweep runs in the background (hours).
# CLEANUP_INTERVAL_HOURS=6

# ── Limits (size these to the server; see docs/OPERATIONS.md) ──
# Largest upload. About 20 MB of memory per MB of file while it loads.
# MAX_FILE_MB=50
# Uploads, reports and model trainings that run at once; the rest wait.
# MAX_HEAVY_JOBS=2
# Per client: storage in MB and number of datasets (0 = no limit).
# MAX_STORAGE_MB=1024
# MAX_DATASETS=50
# Uploads pause while the data disk has less than this free.
# MIN_FREE_DISK_MB=300
# API requests per caller per minute (0 = unlimited).
# RATE_LIMIT_PER_MINUTE=300
# Shown to clients on error screens and the account page.
# SUPPORT_EMAIL=
# The public address of the app. Used in the Claude connector address shown
# on the account page and in report download links.
# APP_PUBLIC_URL=https://analytics.example.com
# A snapshot of all data every N hours, kept on the data disk (0 = off),
# and how many to keep. Download one regularly: they do not survive losing
# the disk.
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=3
# Unexpected errors are posted here as {"text": ...} (Slack, Discord
# "/slack" and similar incoming webhooks). At most one every five minutes.
# ALERT_WEBHOOK_URL=

# ── Auth internals (optional) ──
# Signs client login tokens. Auto-generated + persisted if you leave this
# unset — only set it explicitly if you run multiple backend instances
# behind a load balancer, so they all accept each other's tokens.
# APP_SECRET=
# How many days a client stays logged in before signing in again.
# TOKEN_TTL_DAYS=30

# ── CORS ──
# Other websites allowed to call the API from a browser. Leave unset when
# the app is used from its own address (the normal case).
# CORS_ORIGINS=https://yourdomain.com

# ── Local / open-source model (optional) ──────────────────
# Any OpenAI-compatible server: Ollama, llama.cpp, vLLM, LM Studio.
# Used as a fallback when the cloud providers are unavailable, and as the
# only provider when LLM_PRIVACY_MODE is on.
# Setting the URL is enough to turn it on; the model defaults to
# gemma3:12b, which is openly licensed and runs on a laptop.
#   ollama pull gemma3:12b       (~8GB, good general choice)
#   ollama pull gemma3:4b        (smaller machines)
#   ollama pull gemma3:27b       (workstation, noticeably better prose)
# Any instruction-tuned open model works — set the tag you pulled.
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=gemma3:12b
# LOCAL_LLM_TIMEOUT=120

# Set to 1 for client data that must not be sent to a third-party API.
# Cloud calls are then refused, not merely skipped. Reports still build
# without any model — the analysis engines write their own findings and a
# model only adds prose.
# LLM_PRIVACY_MODE=0

# ── Knowledge base limits ─────────────────────────────────
# RAG_MAX_KBS=25
# RAG_MAX_FILES=100
# RAG_MAX_CHUNKS=8000

# ── Upload safety ─────────────────────────────────────────
# Every upload is checked by content (renamed programs, macro workbooks,
# compression bombs and encrypted workbooks are refused). To also scan each
# file with ClamAV, point at a clamd daemon. If it is configured but
# unreachable, uploads are refused rather than accepted unscanned.
# CLAMD_HOST=clamav
# CLAMD_PORT=3310
# CLAMD_SOCKET=/run/clamav/clamd.ctl   (instead of host/port)
# CLAMD_TIMEOUT=60
# MAX_UNZIPPED_MB=1024
# MAX_ROWS=2000000
